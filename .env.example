# Public site URL used for metadata, sitemap, and canonical URLs
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Future public API base URL (browser-safe)
NEXT_PUBLIC_API_URL=

# Future server-only API base URL (never expose secrets with NEXT_PUBLIC_)
API_URL=

# Future server-only secrets (do not commit real values)
# API_SECRET=
